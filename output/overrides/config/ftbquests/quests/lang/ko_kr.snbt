	quest.170C31F3BAF050BC.quest_subtitle: "재처리기에서 제작됨"
	quest.170C31F3BAF050BC.title: "블루토늄 벌"
	quest.176ACC61DC206E55.quest_desc: ["크림슨 포레스트(Crimson Forests)에서 이 벌들을 찾을 수 있습니다. 그 둥지는 진홍색 곰팡이를 키워도 2% 확률로 얻을 수 있습니다."]
