	quest.2E0275C21D3F0DA3.quest_desc: ["드라코닉 벌과 혼동하지 마십시오."]
	quest.2E0275C21D3F0DA3.quest_subtitle: "와이번 퓨전 크래프팅"
	quest.2E0275C21D3F0DA3.title: "드라코늄 벌"
