	quest.1EABF2E7AE7B8F22.title: "&8네더라이트&r"
	quest.1EBF234015B26F15.quest_desc: ["&a&lRoots Classic&r에서 추가하는 기본 방어구로, 얻으려면 의식이 필요합니다!"]
	quest.1EBF234015B26F15.quest_subtitle: "14"
