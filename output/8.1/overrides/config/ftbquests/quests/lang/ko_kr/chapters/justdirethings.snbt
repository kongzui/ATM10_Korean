	quest.2409EAD96CE3BDF7.quest_desc: ["블레이즈골드 형판은 마법 부여와 설치된 업그레이드를 유지하면서 페리코어 방어구와 도구를 블레이즈골드로 업그레이드할 때 사용합니다."]
	quest.242F74010488F261.quest_desc: ["연료캔은 연료를 더욱 효율적으로 사용할 수 있게 해주는 아이템입니다. 50,000 연료를 저장할 수 있으며, 각 가연성 아이템은 제련된 아이템의 양에 따라 연료 값이 다릅니다. 하나의 연료로 하나의 아이템을 제련할 수 있습니다."]
	quest.24BA4B4EED0A9DBD.quest_desc: [
			"적용 가능한 업그레이드:"
			"- 정신 안개"
		]
	quest.25213DBA6E6CEDD2.quest_desc: [
			"섀도우펄스 구는 JDT가 추가하는 네 번째이자 마지막 티어의 구이며, 고대 도시와 워든의 재료로 제작합니다."
			""
			"해금되는 제작법:"
			"- 이클립스 합금"
			"- 이클립스 엠버"
			"- 시간 수정"
		]
	quest.25E915AE1FC53254.quest_desc: ["셀레스티젬 형판은 마법 부여와 설치된 업그레이드를 유지하면서 블레이즈골드 방어구와 도구를 셀레스티젬으로 업그레이드할 때 사용합니다."]
	quest.27FD46A8C958D259.quest_desc: ["죽음 귀환의 토템은 플레이어가 사망한 위치로 돌아갈 수 있게 해 주는 일회용 아이템입니다."]
	quest.283D7E65F2AD45F2.quest_desc: [
