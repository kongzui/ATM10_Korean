{
	quest.03164C4C7813CE2B.quest_desc: [
			"퀀텀 컴퓨터는 강력한 제작 CPU입니다. 사용할 제작 저장소가 충분한 한 제작 작업을 제한 없이 실행하고, 여러 작업이 보조 처리 스레드를 공유할 수 있습니다."
			""
			"최소 3x3x3, 최대 7x7x7 크기의 직육면체여야 합니다. 또는 퀀텀 컴퓨터 코어 하나만으로도 퀀텀 컴퓨터를 구성할 수 있습니다."
			""
			"퀀텀 컴퓨터 멀티블록에는 다음 조건이 필요합니다:"
			"- 멀티블록 내부에 빈 공간이 없어야 합니다. 추가 효과가 없는 퀀텀 제작 장치로 채울 수 있습니다."
			"- 퀀텀 컴퓨터 코어 정확히 하나"
			"- 퀀텀 데이터 얽힘기 최대 하나"
			"- 퀀텀 컴퓨터 멀티 스레더 최대 하나"
			"- 외부 층의 모든 블록은 퀀텀 컴퓨터 구조 유리여야 합니다."
			"- 내부에는 퀀텀 컴퓨터 구조 유리를 놓을 수 없습니다."
			""
			"특이점을 잔뜩 만들 준비를 하세요."
		]
	quest.03164C4C7813CE2B.title: "무제한 제작 작업: 퀀텀 컴퓨터"
	quest.034AB493E1EC2E63.quest_desc: [
			"조립기 매트릭스 코어는 멀티블록의 패턴 용량, 제작 작업 수와 속도를 결정합니다."
			""
			"제작 코어는 동시에 실행할 수 있는 제작 작업을 8개씩 늘립니다."
			"패턴 코어는 패턴 슬롯을 36개씩 늘립니다."
			"가속 코어는 가속 카드처럼 작동하여 제작 작업의 속도를 높입니다. 가속 코어를 5개보다 많이 설치해도 각 제작 작업의 속도에는 추가 효과가 없습니다."
		]
	quest.034AB493E1EC2E63.title: "조립기 매트릭스 코어"
	quest.07E5B0BF7D8E055A.quest_subtitle: "회피 확률 +30%"
	quest.09F43EB79DDBD127.quest_desc: [
			"퀀텀 데이터 얽힘기는 아이템을 여러 차원에 저장하여 퀀텀 컴퓨터 멀티블록의 제작 저장소를 실질적으로 6배로 늘립니다. 예를 들어 256M 퀀텀 제작 저장소는 1.5G 제작 저장소가 됩니다."
			""
			"&l퀀텀 컴퓨터 멀티블록에는 이 블록을 1개만 넣을 수 있습니다."
		]
	quest.09F43EB79DDBD127.title: "퀀텀 데이터 얽힘기"
	quest.0A354B4707894A62.quest_subtitle: "점프 높이 최대 +3"
	quest.0B4CE3969067FA31.quest_desc: [
			"퀀텀 갑옷에는 여러 종류의 업그레이드를 설치할 수 있습니다."
			""
			"퀀텀 갑옷을 업그레이드하려면 해당 키 설정(기본값 N)을 눌러 퀀텀 갑옷 설정 메뉴를 여세요."
		]
	quest.0B4CE3969067FA31.title: "퀀텀 갑옷 업그레이드"
	quest.0D8B4DAB82ABEF9D.quest_desc: ["퀀텀 컴퓨터 가속기는 각각 퀀텀 컴퓨터 멀티블록에 보조 처리 스레드 12개를 추가합니다. 퀀텀 컴퓨터가 실행하는 모든 제작 작업은 모든 보조 처리 스레드를 공유할 수 있으므로, 이 블록을 많이 마련하는 것이 좋습니다."]
	quest.0D8B4DAB82ABEF9D.title: "퀀텀 컴퓨터 가속기"
	quest.0E06F323BF8C1D73.quest_desc: [
			"싹 틔우는 엔트로화 플루익스는 반드시 열화하므로, 엔트로 결정을 자동으로 얻을 다른 방법이 필요할 수 있습니다."
			""
			"다행히 그 일을 해 주는 벌이 있습니다. 씨앗도 있고요."
		]
	quest.0E06F323BF8C1D73.quest_subtitle: "열화를 감당하기 어려울 때"
	quest.0E06F323BF8C1D73.title: "엔트로 결정 자동화"
	quest.12749A25600C7FF3.quest_desc: [
			"퀀텀 제작기는 강력하고 설정 가능한 자동 제작기입니다. ME 네트워크의 전체 인벤토리를 이용할 수 있어 끊임없는 제작도 간단히 처리합니다. 제작 작업을 매우 빠르게 실행하며, 유체 대체와 재귀 제작(대장장이 형판 복제 등)도 지원합니다."
			""
			"각 재료를 얼마나 유지할지와 완성품을 최대 몇 개까지 재고로 유지할지도 조절할 수 있습니다."
			""
			"다만 패턴 공급기의 제작 요청은 받지 않습니다."
		]
	quest.12749A25600C7FF3.title: "퀀텀 제작기"
	quest.14FC9E4A3C80C0AE.quest_desc: [
			"반응 챔버는 촉매 유체와 많은 전력을 사용하여 내부에서 여러 월드 내 반응을 가속할 수 있습니다. 통제된 환경에서 반응 효율을 높여 더 많은 재료를 얻을 수 있습니다."
			""
			"이 기계는 전력 소모가 상당하므로, ME 네트워크에 충분한 발전 설비와 에너지 셀을 마련하는 것이 좋습니다."
			""
			"Advanced AE의 퀀텀 관련 제작법에도 이 기계가 필요합니다."
		]
	quest.14FC9E4A3C80C0AE.title: "반응 챔버"
	quest.18499D33BA12A8A9.quest_desc: ["형성 평면이 저장 버스처럼 작동해 자동화하기 불편하다고 느낀 적이 있나요? ME 능동 형성 평면을 사용해 보세요. ME 반출 버스처럼 작동하지만 월드를 출력 대상으로 사용합니다. 이 장치에는 서브넷이 필요하지 않습니다."]
	quest.18499D33BA12A8A9.quest_subtitle: "밖으로 내보내기: 능동형"
	quest.18499D33BA12A8A9.title: "네트워크에서 능동적으로 배치: ME 능동 형성 평면"
	quest.1A20BBBAFBEDF911.quest_desc: [
			"퀀텀 컴퓨터 멀티 스레더는 퀀텀 컴퓨터 멀티블록의 보조 처리 스레드를 6배로 늘립니다. 예를 들어 멀티블록에 이 블록이 있으면 퀀텀 컴퓨터 가속기 하나가 보조 처리 스레드 72개를 제공합니다."
			""
			"&l퀀텀 컴퓨터 멀티블록에는 퀀텀 컴퓨터 멀티 스레더를 하나만 넣을 수 있습니다.&r"
			""
			"ATM의 별 재료로도 사용합니다."
		]
	quest.1A20BBBAFBEDF911.title: "퀀텀 컴퓨터 멀티 스레더"
	quest.1A815711703E4A24.quest_desc: ["이 퀘스트는 AllTheMods 모드팩에서 사용할 수 있도록 &6AllTheMods 스태프&r 또는 &2커뮤니티 기여자&r가 작성했습니다.\\n\\n모든 &6AllTheMods&r 팩은 &e모든 권리 보유&r 라이선스를 따르므로, &6AllTheMods 팀&r의 명시적인 허가 없이 팀에서 출시하지 않은 공개 모드팩에 이 퀘스트를 사용할 수 없습니다.\\n\\n이 퀘스트는 의도적으로 숨겨져 있습니다. 이 내용이 보인다면 편집 모드입니다."]
	quest.1B90B94D07BBDD09.quest_desc: [
			"Extended AE의 모든 장치를 만들기에는 제작대의 망치와 펜치만으로 부족합니다."
			""
			"복잡한 작업을 처리할 수 있는 기계인 결정 조립기로 업그레이드할 때입니다."
			""
			"결정 조립기를 사용하면 Extended AE의 다양한 장치를 조립할 수 있습니다."
			""
			"월드 내 반응도 처리할 수 있지만 반응 챔버만큼 효율적이지는 않습니다. 프로세서도 한 번에 4개씩 조립할 수 있습니다."
			""
			"화면이 있는 면은 ME 네트워크에 연결할 수 없습니다."
		]
	quest.1B90B94D07BBDD09.title: "복잡한 제작: 결정 조립기"
	quest.1E535784A9D3DE89.quest_desc: ["Extended AE에서 엔트로 결정이 필요하지 않은 항목입니다."]
	quest.27FC0C092EE00532.quest_desc: ["ME 주입기는 양동이와 화학 탱크처럼 유체, 화학 물질 또는 에너지를 담을 수 있는 용기를 채우거나 비울 수 있습니다. 패턴으로 용기를 채우면 패턴 공급기로 자동 출력합니다."]
	quest.27FC0C092EE00532.quest_subtitle: "영문명 Canner와 Caner를 혼동하지 마세요"
	quest.27FC0C092EE00532.title: "이 유체를 담아 보세요: ME 주입기"
	quest.2E61219FC0BAB675.quest_subtitle: "도달 거리 최대 +5"
	quest.3347CB6478F486C6.quest_subtitle: "어디서나 셀 작업대 사용"
	quest.34FBD04361657724.quest_desc: [
			"Extended AE의 여러 제작법에는 &a엔트로 결정&r이 필요합니다."
			""
			"&a엔트로 결정&r을 얻으려면 플루익스 블록과 엔트로 씨앗이 필요합니다. 엔트로 씨앗으로 플루익스 블록을 우클릭하세요."
			""
			"그러면 &a싹 틔우는 엔트로화 플루익스&r가 만들어지고, 싹 틔우는 서투스 석영처럼 주변에 엔트로 봉오리가 자랍니다. 서투스 석영과 달리 열화는 피할 수 없습니다."
			""
			"&a싹 틔우는 엔트로화 플루익스&r를 부수면 상태와 관계없이 항상 &l하나&r의 &a엔트로 가루&r가 나옵니다. 완전히 자라지 않은 엔트로 봉오리는 엔트로 파편을 떨어뜨립니다."
		]
	quest.34FBD04361657724.quest_subtitle: "시간 수정과 혼동하지 마세요"
	quest.34FBD04361657724.title: "시공간의 결정: 엔트로 결정"
	quest.3621155A4138EBCA.quest_desc: [
			"ME 소거 셀은 사용하기 전에 셀 작업대에서 파티션을 설정해 필터를 지정해야 합니다. 셀의 우선순위를 다른 저장소보다 높게 설정하면, 필터와 일치하는 항목이 ME 시스템에 들어올 때 삭제하거나 물질 응축기처럼 물질 덩어리 또는 특이점으로 응축합니다."
			""
			"우클릭하여 설정 GUI를 여세요."
		]
	quest.3621155A4138EBCA.title: "셀 안의 물질 응축기: ME 소거 셀"
	quest.36FB694262102CFD.quest_desc: [
			"Extended AE에는 무한 셀이라는 새로운 종류의 셀이 있습니다."
			""
			"이 셀은 물, 조약돌, 용암 같은 특정 자원을 무한히 공급합니다."
		]
	quest.36FB694262102CFD.quest_subtitle: "싱크대를 셀로 만든 것"
	quest.36FB694262102CFD.title: "필요 이상으로 많은 자원: 무한 셀"
	quest.38D0BBD5F699EF41.quest_desc: ["무선 액세스 포인트에 연결되어 있으면 퀀텀 갑옷 부위가 ME 시스템의 에너지로 충전됩니다. 퀀텀 흉갑에 설치하면 인벤토리의 아이템도 재충전합니다. Applied Flux와 함께 사용할 때는 특별히, 네트워크에 FE 셀이 있으면 그 셀에서 에너지를 끌어옵니다."]
	quest.3916B48D7F294932.quest_desc: ["ME 무선 허브는 ME 무선 연결기의 업그레이드 버전입니다. 서로 다른 무선 연결기 또는 허브에 최대 8개까지 연결할 수 있습니다. 단, 허브 전체에서 전송할 수 있는 채널은 총 32개입니다."]
	quest.3916B48D7F294932.title: "연결의 분기: ME 무선 허브"
	quest.3972EE0ECB215843.quest_desc: ["Extended AE와 Advanced AE는 Applied Energistics 2의 애드온입니다. 두 모드 모두 여러 장치의 개선형을 비롯한 다양한 기능을 추가하여 플레이 경험을 향상하는 데 중점을 둡니다."]
	quest.3972EE0ECB215843.title: "Extended AE 및 Advanced AE"
	quest.3B3F1DE1AF6EBC1E.quest_subtitle: "힘 +10"
	quest.3CF32F2314839B1D.quest_desc: [
			"싹 틔우는 서투스 석영과 엔트로화 플루익스가 열화되는 데 지치셨나요? 결정 복원기로 고칠 수 있습니다! 충전된 서투스 석영으로 싹 틔우는 서투스 석영을 복원하고, 엔더 가루로 엔트로화 플루익스를 복원할 수 있습니다."
			""
			"낮은 확률로 흠잡을 데 없는 싹 틔우는 서투스 석영을 만들기도 합니다."
		]
	quest.3CF32F2314839B1D.title: "열화된 결정 복원: 결정 복원기"
	quest.3FE739EA7E297DF3.quest_desc: [
			"확장 장치는 용량이 더 크거나 속도가 더 빠르며, 둘 다일 수도 있는 AE2 장치의 변형입니다."
			""
			"예를 들어 ME 확장 패턴 공급기에는 일반 패턴 공급기의 4배인 36개의 패턴 슬롯이 있습니다."
			""
			"ME 확장 반입·반출 버스는 일반 버스보다 약 8배 빠르게 작동하며 더 많은 업그레이드를 지원합니다."
			""
			"대부분 기본 장치의 업그레이드 버전이므로 장치마다 별도의 퀘스트를 만들지는 않습니다."
		]
	quest.3FE739EA7E297DF3.title: "더 빠르고 더 크게: 확장 장치"
	quest.411A463E98C3B102.quest_desc: [
			"퀀텀 컴퓨터, 제작기와 갑옷을 만드는 데 필요한 재료입니다."
			""
			"부서진 특이점은 반응 챔버에 특이점 하나, 엔더 가루 2개, 천령석 가루 2개와 용암 100 mB를 넣어 만듭니다."
			""
			"퀀텀 주입액 1양동이는 물 4양동이와 퀀텀 주입 가루로 만듭니다. 퀀텀 주입 가루는 부서진 특이점을 각인기 또는 Mekanism 분쇄기에 넣어 얻습니다."
			""
			"퀀텀 합금은 퀀텀 주입액 1양동이, 구리 주괴 4개, 부서진 특이점 4개와 일반 특이점 4개로 만듭니다."
		]
	quest.411A463E98C3B102.title: "퀀텀 재료"
	quest.4818C8387C0DBBE7.quest_desc: [
			"Extended AE는 Applied Energistics 2의 애드온으로, 여러 장치의 개선형을 추가하고 이전 AE2 버전의 일부 기능을 되살리는 데 중점을 둡니다."
			""
			"시작하려면 플루익스 블록을 준비하세요."
		]
	quest.4818C8387C0DBBE7.title: "Extended AE"
	quest.48357A7486125C52.quest_desc: [
			"각인기의 느린 속도에 지치셨나요?"
			""
			"회로 절단기를 소개합니다! 금 블록 같은 블록을 회로로 절단하여 한 번에 최대 9개의 회로를 만들 수 있습니다. 서투스 또는 엔트로 회로는 4개까지 만들 수 있습니다."
			""
			"포트가 없는 회로 절단기의 유리 면은 ME 네트워크에 연결할 수 없습니다."
		]
	quest.48357A7486125C52.title: "블록을 회로로: 회로 절단기"
	quest.4AC3EA41234BC5F0.quest_subtitle: "최대 체력 +20"
	quest.52CD31F48715B17C.quest_desc: [
			"ME 무선 연결기는 양자 브리지처럼 ME 네트워크의 두 지점을 무선으로 연결합니다. 양자 브리지와 달리 약 1000블록 이내의 무선 연결기에만 연결할 수 있으며, 차원을 넘어 연결할 수 없습니다."
			""
			"&l연결하려면 연결할 두 ME 무선 연결기에 ME 무선 설정 키트를 사용하세요.&r"
			""
			"색상 도포기로 ME 무선 연결기의 색상을 바꿀 수도 있습니다. 그러면 색상이 다른 케이블이나 무선 연결기에는 연결되지 않습니다."
		]
	quest.52CD31F48715B17C.title: "장거리 연결: ME 무선 연결기"
	quest.534D827A628907F4.quest_desc: [
			"ME 확장 패턴 접근 터미널은 일반 패턴 접근 터미널과 같은 방식으로 작동하지만 3가지 기능이 더 있습니다."
			""
			"&l&n향상된 패턴 검색&r"
			""
			"입력 또는 출력 재료의 이름으로 패턴을 검색할 수 있습니다."
			""
			"&l&n패턴 강조&r"
			""
			"패턴이 묶음으로 표시되는 방식 때문에 원하는 패턴을 찾기 어려울 때가 있습니다. 이 터미널에서는 찾고 있는 패턴이 GUI에서 강조 표시됩니다."
			""
			"&l&n월드 내 패턴 공급기 강조&r"
			""
			"대규모 제작 작업에서 어느 패턴 공급기가 막혔는지 찾기 번거로울 수 있습니다. ME 확장 패턴 접근 터미널은 월드에서 패턴 공급기를 강조 표시하여 더 쉽게 찾을 수 있게 합니다."
		]
	quest.534D827A628907F4.title: "더 나은 패턴 접근: ME 확장 패턴 접근 터미널"
	quest.55DFC96B4CDBFA7D.quest_desc: ["퀀텀 컴퓨터 코어는 퀀텀 컴퓨터의 심장입니다. 자체적으로 256M 제작 저장소와 보조 처리 스레드 12개를 제공합니다. 연결부가 있는 위쪽 또는 아래쪽 면으로 전력을 공급하면, 단독으로 퀀텀 컴퓨터를 구성할 수 있는 유일한 블록이기도 합니다. 하지만 멀티블록으로 구성하면 훨씬 강력한 컴퓨터를 만들 수 있습니다."]
	quest.55DFC96B4CDBFA7D.title: "퀀텀 컴퓨터 코어"
	quest.56DE217FEAE3F036.quest_desc: [
			"ME 고급 패턴 공급기는 일반 또는 확장 패턴 공급기에, 패턴의 각 아이템을 보낼 기계의 면을 지정하는 기능을 추가한 새로운 ME 패턴 공급기입니다. 이를 이용하면 Mekanism의 금속공학 주입기처럼 특정 입력을 특정 면으로 넣어야 하는 기계도 파이프나 서브넷 없이 블록 하나로 자동화할 수 있습니다."
			""
			"이 기능을 사용하려면 각 재료를 기계의 어느 면으로 보낼지 정하는 고급 패턴 인코더가 필요합니다."
		]
	quest.56DE217FEAE3F036.quest_subtitle: "Mekanism, 바로 당신 말이에요"
	quest.56DE217FEAE3F036.title: "면별 패턴 지정: 고급 패턴 공급기"
	quest.5E610C059737628B.quest_subtitle: "단차 높이 최대 +3"
	quest.6033ABA2088BA70C.quest_subtitle: "비행 관성 제거"
	quest.6559C57A1A476489.quest_subtitle: "공격 속도 +5"
	quest.658DEAAD1E68E549.quest_desc: ["이 블록은 퀀텀 컴퓨터 코어의 제작 저장소를 확장합니다. 퀀텀 컴퓨터가 동시에 실행할 수 있는 작업 수를 실질적으로 늘리며, 퀀텀 컴퓨터 코어를 만드는 데도 필요합니다."]
	quest.658DEAAD1E68E549.title: "대용량 제작 저장소: 퀀텀 컴퓨터 저장소"
	quest.67C7EF299BEC37DE.quest_subtitle: "창의적 비행"
	quest.763A19067AEEF6D5.quest_subtitle: "행운 +2"
	quest.7725CB7D0AE55180.quest_desc: [
			"Advanced AE는 Applied Energistics 2의 애드온으로, ME 시스템을 다룰 때의 사용자 경험을 개선하고 최종 단계 시스템의 가능성을 확장하는 데 중점을 둡니다."
			""
			"기계의 특정 면으로 재료를 보낼 수 있는 패턴 공급기부터, 제한 없이 제작 작업을 실행하고 작업 사이에 보조 처리 스레드를 공유할 수 있는 멀티블록 컴퓨터까지 다양한 기능을 제공합니다."
		]
	quest.7725CB7D0AE55180.title: "Advanced AE"
	quest.78215D704E6095B0.quest_desc: ["&5&lMekanism&r과 &l&7Modern Industrialization&r만 최종 단계 갑옷으로 재미를 누릴 수 있다고 생각하셨나요? \\n\\n이 &5퀀텀 갑옷&r은 &c네더라이트 갑옷&r과 비슷한 기본 능력치를 지니지만, &a메카슈트&r처럼 에너지를 방패로 사용할 수 있습니다. \\n비행, 야간 투시, 재충전처럼 사용자를 더욱 강하게 만드는 업그레이드도 설치할 수 있습니다! \\n\\n가장 좋은 점은 저장소 시스템에 연결할 수 있다는 것입니다! 그러면 어디에 있든 시스템에서 자동으로 에너지를 끌어오고 아이템을 꺼낼 수 있습니다. \\n\\n또한 전 부위를 착용하면 &a방사선&r으로 인한 죽음을 막을 수 있습니다."]
	quest.78215D704E6095B0.quest_subtitle: "완전히 무적이 되지는 않습니다"
	quest.78215D704E6095B0.title: "갑옷이 된 ME 시스템: 퀀텀 갑옷"
	quest.7900A4836CC55428.quest_desc: [
			"조립기 매트릭스는 여러 분자 조립기와 패턴 공급기를 한 채널에 담을 수 있는 멀티블록입니다."
			""
			"조립기 매트릭스는 최소 3x3x3, 최대 7x7x7 크기의 직육면체여야 합니다. 다음 부품이 필요합니다:"
			"- 모서리: 조립기 매트릭스 프레임"
			"- 면: 조립기 매트릭스 벽 또는 유리"
			"- 내부: 조립기 매트릭스 패턴·제작·가속 코어"
			""
			"유효한 조립기 매트릭스에는 패턴 코어와 제작 코어가 각각 하나 이상 있어야 합니다. 내부를 완전히 채워야 하며 비어 있을 수 없습니다. 조립기 매트릭스가 올바르게 형성되고 전력을 공급받으면 프레임의 선이 파란색으로 바뀝니다."
			""
			"{@pagebreak}"
			""
			"이 예시에서는 제작 코어와 패턴 코어의 균형에 중점을 둔 7x7x7 조립기 매트릭스를 만듭니다."
			""
			"먼저 조립기 매트릭스 프레임 43개와 조립기 매트릭스 벽 125개를 만드세요. 이 퀘스트 보상으로 각각 25개를 드립니다. 그러면 프레임 68개와 벽 150개가 됩니다."
		]
	quest.7900A4836CC55428.quest_subtitle: "한 채널에 여러 분자 조립기와 패턴 공급기"
	quest.7900A4836CC55428.title: "여러 조립기를 하나로: 조립기 매트릭스"
	quest.7E35ED5B30697722.quest_desc: ["궁극의 퀀텀 컴퓨터 구성을 원하셨나요? 보조 처리 스레드를 최대로 늘리는 구성은 이렇습니다.\\n\\n퀀텀 컴퓨터 구조 유리 218개, 퀀텀 컴퓨터 가속기 123개, 퀀텀 컴퓨터 코어 1개와 퀀텀 컴퓨터 멀티 스레더 1개가 필요합니다. 이렇게 하면 보조 처리 스레드가 총 8928개가 됩니다. 코어의 256M 제작 저장소만으로도 이미 충분하므로 여기에는 코어 외의 저장소를 넣지 않았습니다. 데이터 얽힘기 퀘스트가 선택 사항인 데에는 이유가 있습니다.\\n\\nQ.C. 구조 유리 200개와 Q.C. 가속기 100개를 가져오면 나머지는 제가 드릴게요. Apothic Enchanting 챕터만큼이나 후하답니다."]
	quest.7E35ED5B30697722.title: "궁극의 퀀텀 컴퓨터"
	task.13FF4A021BBF1451.title: "무한 셀"
