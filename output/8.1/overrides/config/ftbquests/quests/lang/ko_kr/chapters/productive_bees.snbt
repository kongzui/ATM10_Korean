	quest.264BFB8C5F79616F.quest_desc: ["눈 덮인 생물 군계에 눈 둥지를 놓으면 땀 벌을 유인할 수 있습니다."]
	quest.264BFB8C5F79616F.quest_subtitle: "추운 생물 군계에서 땀 벌 유인"
	quest.26B3AE1E77A84BCB.quest_desc: ["&9오스뮴 벌 생성 알&r, &b충전된 서투스 석영&r 및 &8천령석&r을 용암에 던지면 &e스카이 오스뮴 벌 생성 알이 생성됩니다."]
	quest.26B3AE1E77A84BCB.title: "스카이 오스뮴 벌"
	quest.26B9909717528D5E.quest_subtitle: "The Undergarden에서 발견"
	quest.26B9909717528D5E.title: "우테릭 벌"
	quest.26FB7A789981BD3C.quest_subtitle: "석탄 벌에게 흑연 블록 먹이기"
	quest.26FB7A789981BD3C.title: "석묵 벌"
	quest.28AE3B536D23E138.quest_subtitle: "주입 제작"
	quest.28AE3B536D23E138.title: "인퍼륨 벌"
	quest.2982D38BD5EE6349.quest_desc: ["뒤틀린 숲 주변을 돌아다니는 이 벌들을 발견할 수 있습니다. 둥지는 뒤틀린 곰팡이를 키워도 2% 확률로 얻을 수 있습니다."]
	quest.2982D38BD5EE6349.quest_subtitle: "슈룸비에게 뒤틀린 균을 먹이세요"
	quest.2982D38BD5EE6349.title: "Warped Shroombee"
	quest.29A71E780923874E.quest_subtitle: "유목민 + 갈대"
	quest.29A71E780923874E.title: "실리콘 벌"
	quest.29EE878BC8D3A742.quest_desc: [
			"우리만의 양봉장을 시작하려면 먼저 벌을 찾아 포획해야 합니다."
			""
			"이것을 들고 벌을 우클릭하면 벌을 잡을 수 있습니다!"
			""
			"모험 중에 &6튼튼한 벌 케이지&r를 얻을 수도 있으니 잘 살펴보세요!"
		]
	quest.29EE878BC8D3A742.title: "벌 포획!"
	quest.2A559D527BC88DEC.quest_desc: ["&9공간 벌 생성 알&r과 &8하늘 강철 블록&r을 용암에 던지면 스카이 스틸 벌 생성 알이 생성됩니다."]
	quest.2A559D527BC88DEC.title: "스카이 스틸 벌"
	quest.2AEC294578952BFD.quest_subtitle: "청금석 + 골격"
	quest.2AEC294578952BFD.title: "염료 벌"
	quest.2AEEDCC6826CF4AB.quest_subtitle: "수상한 물고기 벌 장사"
	quest.2AEEDCC6826CF4AB.title: "기름 벌"
	quest.2BE538246C672689.quest_desc: ["주조소를 사용하여 &#F2EB2EVibranium 벌 생성 알&r 위에 &#9332D9용융 Unobtainium&r을 붓습니다."]
	quest.2BE538246C672689.title: "Unobtainium 벌"
