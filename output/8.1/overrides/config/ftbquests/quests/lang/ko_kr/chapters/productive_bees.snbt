	quest.1DF026030780AE96.quest_subtitle: "벌통에 있는 벌에게서 유전자를 추출합니다"
	quest.1E9BD4B74DAEA9FC.quest_desc: ["벌을 이 둥지로 유인하려면 꿀 간식 대신 튀긴 후렴과가 필요합니다."]
	quest.1E9BD4B74DAEA9FC.quest_subtitle: "엔드에 설치하면 엔더 벌을 유인합니다."
	quest.1EBD5E4410A6DF34.quest_subtitle: "유령 벌에게 소울륨 단검 먹이기"
	quest.1EBD5E4410A6DF34.title: "소울륨 벌"
