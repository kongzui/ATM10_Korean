	quest.54CBCD9D2F1AD907.title: "아르카누스 벌"
	quest.5563BD4934297522.quest_desc: ["다이아몬드 벌과 점액질 벌을 교배해 에메랄드 벌을 만드세요!"]
	quest.5563BD4934297522.quest_subtitle: "다이아몬드 + 점액질"
