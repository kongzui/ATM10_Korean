	quest.369D3AF332181DA8.quest_desc: ["돌 둥지는 모든 오버월드 생물 군계에서 석공 벌이나 땅파기 벌을 유인합니다."]
	quest.369D3AF332181DA8.quest_subtitle: "모든 오버월드 생물 군계에서 벌을 유인합니다"
