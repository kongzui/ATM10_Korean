  "quest.1636F3F12E92CAEA.quest_desc": [
    "물뿌리개를 사용하려면 물 원천 블록을 우클릭해 물을 채우세요. 작물을 겨냥한 채 우클릭을 누르고 있으면 물뿌리개의 효과 범위 안에 있는 작물에 물을 줍니다.",
    "",
    "에센스 물뿌리개에는 자동 물 주기 기능이 있습니다. 블록을 겨냥하지 않은 상태에서 Shift + 우클릭하면 이 기능을 켜거나 끌 수 있습니다. 켜져 있을 때는 물뿌리개가 마법 부여된 것처럼 빛납니다."
  ],
  "quest.16E3031D800B40D5.quest_desc": [
    "소울륨 소환기는 몹 에센스를 사용해 몹을 스폰합니다. 예를 들어 가스트 에센스를 넣으면 가스트를 스폰할 수 있습니다."
  ],
  "quest.1E0F92F07FDD162E.quest_subtitle": "모든 건 (씨앗) 기반재부터",
  "quest.217DB12EA32E1724.quest_desc": [
    "&b주입 수정&r은 에센스의 등급을 올리는 데 필요합니다. 예를 들어 인퍼륨 에센스 4개와 주입 수정을 조합하면 프루덴튬 에센스 1개를 얻습니다.\\n\\n나중에는 부서지지 않는 주입 수정도 만들 수 있습니다."
  ],
  "quest.224CE21E56703F6E.quest_desc": [
    "마법봉으로 주입 제단을 활성화할 수 있습니다. 제단을 우클릭해 주입 과정을 시작하세요."
  ],
  "quest.224CE21E56703F6E.quest_subtitle": "마법사가 되었습니다(이름을 넣으세요)!",
  "quest.2DDA04088C8220D2.quest_subtitle": "마침내 번영을 누릴 수 있겠습니까?",
  "quest.37B297640F537383.quest_desc": [
    "미조율 증강은 주입 제단에서 여러 증강을 만드는 재료입니다. 이 증강으로 &e성급함&r, &1야간 투시&r, &b추락 피해 저항&r, &6화염 저항&r 등 다양한 효과를 얻을 수 있습니다!"
  ],
  "quest.3EA2578C3A56FAE8.quest_desc": [
    "영혼 추출기를 사용하면 영혼 항아리를 넣고 몹 아이템으로 채울 수 있습니다. 예를 들어 썩은 살점을 추가하면 좀비 영혼의 일부를 얻을 수 있습니다."
  ],
  "quest.41DBE44D7AA0B623.quest_desc": [
    "땜장이 작업대에서 에센스 장비에 증강을 추가할 수 있습니다!"
  ],
  "quest.6235B9923BE0AAEB.quest_desc": [
    "마법 부여기는 아이템과 에센스를 사용해 마법 부여 가능한 아이템에 마법을 부여하는 블록입니다."
  ],
  "quest.6235B9923BE0AAEB.title": "&b마법 부여기",
  "quest.1CF8263756EE8F2A.quest_desc": [
    "이 특별한 &e가루&r는 &d신비한 깨달음&r 마법이 부여된 &d에센스 무기&r로 위더와 엔더 드래곤을 처치하면 얻을 수 있습니다."
  ],
  "quest.2DDA04088C8220D2.quest_desc": [
    "번영 파편은 이 모드의 핵심 제작 재료입니다. 번영 광석을 찾으려면 채굴하러 가세요."
  ]
}
