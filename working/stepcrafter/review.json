    {
      "key": "item.stepcrafter.step_crafter.help",
      "english": "Accepts patterns for recursive autocrafting and allows setting minimum and maximum thresholds. When the output of a configured pattern falls below the minimum in the network, it will automatically craft items up to the maximum.",
      "translation": "패턴에 따라 필요한 재료까지 재귀적으로 자동 제작하며, 최소·최대 재고량을 설정할 수 있어요. 설정한 패턴의 결과물이 네트워크에서 최소량보다 적어지면 최대량까지 자동으로 제작해요.",
      "reviewed": true,
      "status": "new_translation"
    },
    {
      "key": "item.stepcrafter.step_requester.help",
      "english": "When a configured resource drops below its configurable minimum, it requests autocrafters to produce it in the configurable batch size until the configurable maximum is reached.",
      "translation": "설정한 자원이 최소량보다 적어지면 자동 제작기에 제작을 요청해요. 설정한 묶음 크기만큼씩 제작하여 최대량에 도달할 때까지 보충해요.",
      "reviewed": true,
      "status": "new_translation"
    },
    {
      "key": "item.stepcrafter.step_crafter_manager.help",
      "english": "Allows managing all your step crafters from a single interface.",
      "translation": "한 화면에서 모든 단계 제작기를 관리할 수 있어요.",
      "reviewed": true,
      "status": "new_translation"
    },
    {
      "key": "item.stepcrafter.step_crafting_monitor.help",
      "english": "Displays the status of step crafting tasks and allows you to cancel step crafting tasks in your storage network.",
      "translation": "저장소 네트워크의 단계 제작 작업 상태를 표시하고 작업을 취소할 수 있어요.",
      "reviewed": true,
      "status": "new_translation"
    },
    {
      "key": "item.stepcrafter.step_requester_manager.help",
      "english": "Allows managing all your step requester from a single interface.",
      "translation": "한 화면에서 모든 단계 요청기를 관리할 수 있어요.",
      "reviewed": true,
